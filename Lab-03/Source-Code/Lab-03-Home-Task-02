#include <iostream>
using namespace std;

int main() {
    // 5 alag variables me values
    int num1 = 28;
    int num2 = 32;
    int num3 = 37;
    int num4 = 24;
    int num5 = 33;
    
    int sum;
    double average;

    // Pehle sum nikalna hai
    sum = num1 + num2 + num3 + num4 + num5;

    // Phir average ke liye 5 se divide
    average = static_cast<double>(sum) / 5;

    cout << "The five values are 28, 32, 37, 24, 33" << endl;
    cout << "Sum = " << sum << endl;
    cout << "Average = " << average << endl;

    return 0;
}